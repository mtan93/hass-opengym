#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# The app is useless without its API, so take the add-on down with it.
# ==============================================================================
declare exit_code="${1}"

if [[ "${exit_code}" -ne 0 ]] && [[ "${exit_code}" -ne 256 ]]; then
    bashio::log.warning "The openGym API exited with code ${exit_code}, halting the add-on"
fi

exec /run/s6/basedir/bin/halt
